// Regras do Firestore (cole no console: Firestore Database → Regras → Publicar).
// Este arquivo é só a cópia de referência; quem vale é o que está publicado no console.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    function eu() {
      return request.auth.uid;
    }

    // Progresso de cada conta: só o dono lê e grava.
    match /usuarios/{uid} {
      allow read, write: if logado() && eu() == uid;
    }

    // Contador de contas: ficha vazia (sem nome, e-mail nem progresso) que só o dono cria.
    // Qualquer conta pode listar, para a contagem em Eu; os documentos não têm conteúdo.
    match /contas/{uid} {
      allow list: if logado();
      allow get: if logado() && eu() == uid;
      allow create, update: if logado() && eu() == uid && request.resource.data.keys().size() == 0;
    }

    // Foto ou avatar de cada conta: qualquer conta lê (partidas on-line e ranking);
    // só o dono grava, e só foto pequena (128×128 em JPEG) ou link da foto do Google.
    match /perfis/{uid} {
      allow read: if logado();
      allow delete: if logado() && eu() == uid;
      allow create, update: if logado() && eu() == uid && perfilValido(request.resource.data);
    }
    function perfilValido(d) {
      return d.keys().hasOnly(['foto', 'avatar', 'atualizado'])
        && d.atualizado is string
        && (d.foto == null || (d.foto is string && d.foto.size() <= 60000
            && (d.foto.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+') || d.foto.matches('https://[^ ]+'))))
        && (d.avatar == null || (d.avatar is string && d.avatar.size() <= 40));
    }

    // Partidas on-line: qualquer conta lê (o convite é por link); só os jogadores alteram,
    // e quem tem o link (ou o convidado do desafio) pode entrar enquanto ela espera.
    match /partidas/{id} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.criador == eu()
        && request.resource.data.jogadores == [eu()]
        && request.resource.data.estado == 'aguardando'
        && request.resource.data.lances.size() == 0
        && request.resource.data.ratingAplicado == false;
      allow update: if logado() && camposFixos() && (
        eu() in resource.data.jogadores ||
        (resource.data.estado == 'aguardando'
          && (resource.data.convidado == null || resource.data.convidado == eu())
          && request.resource.data.jogadores == resource.data.jogadores.concat([eu()])) ||
        // O convidado de um desafio pode recusar.
        (resource.data.estado == 'aguardando' && resource.data.convidado == eu()
          && request.resource.data.estado == 'cancelada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'motivo']))
      );
      allow delete: if logado() && eu() == resource.data.criador;
    }
    // O que não muda depois de criada; e o ranking, uma vez contado, não "descontado".
    function camposFixos() {
      return request.resource.data.criador == resource.data.criador
        && request.resource.data.valendo == resource.data.valendo
        && request.resource.data.tempo == resource.data.tempo
        && request.resource.data.criada == resource.data.criada
        && (resource.data.ratingAplicado == false || request.resource.data.ratingAplicado == true);
    }

    // Ranking: qualquer conta lê. O dono cria a própria ficha (rating inicial) e troca o nome;
    // o rating só muda no fim de uma partida valendo de que a conta participou, contada na
    // mesma gravação (ultimaPartida aponta para ela), uma partida por vez e no máximo 40 pontos
    // (o K do Elo no app).
    match /jogadores/{uid} {
      allow read: if logado();
      allow create: if logado() && fichaValida(request.resource.data) && (
        (eu() == uid && request.resource.data.partidas == 0 && request.resource.data.rating == 1200)
        || (request.resource.data.partidas == 1
            && math.abs(request.resource.data.rating - 1200) <= 40
            && contouAgora(request.resource.data, uid))
      );
      allow update: if logado() && fichaValida(request.resource.data) && (
        (eu() == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome']))
        || (request.resource.data.nome == resource.data.nome
            && request.resource.data.partidas == resource.data.partidas + 1
            && math.abs(request.resource.data.rating - resource.data.rating) <= 40
            && contouAgora(request.resource.data, uid))
      );
    }
    function fichaValida(d) {
      return d.keys().hasOnly(['nome', 'rating', 'partidas', 'vitorias', 'empates', 'derrotas', 'ultimaPartida'])
        && d.nome is string && d.nome.size() <= 60
        && d.rating is int && d.partidas is int
        && d.vitorias + d.empates + d.derrotas == d.partidas;
    }
    // A partida citada estava sem ranking antes desta gravação e fica com ranking depois,
    // é valendo, acabou, e tanto quem grava quanto o dono da ficha jogaram nela.
    function contouAgora(d, uid) {
      let caminho = /databases/$(database)/documents/partidas/$(d.ultimaPartida);
      let antes = get(caminho).data;
      let depois = getAfter(caminho).data;
      return d.ultimaPartida is string
        && antes.ratingAplicado == false
        && depois.ratingAplicado == true
        && antes.valendo == true
        && antes.estado == 'fim'
        && eu() in antes.jogadores
        && uid in antes.jogadores;
    }
  }
}
