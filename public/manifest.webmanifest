{
  "name": "Treinador de Xadrez",
  "short_name": "Xadrez",
  "description": "Aberturas do MCO e exercícios de mate, com treino de repetição espaçada.",
  "lang": "pt-BR",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fafaf7",
  "theme_color": "#2f6f4f",
  "share_target": {
    "action": "./compartilhar-pgn",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "endereco",
      "files": [
        {
          "name": "arquivos",
          "accept": [".pgn", "application/x-chess-pgn", "application/vnd.chess-pgn", "text/plain"]
        }
      ]
    }
  },
  "icons": [
    { "src": "icones/icone-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icones/icone-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icones/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
